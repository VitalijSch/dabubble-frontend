# Copy to .env.local and fill in real values: cp .env.example .env.local
# .env.local is git-ignored. Every variable here is validated in src/env.ts.

# Public URL of the app (used for absolute links, metadata, redirects).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Origin of the Django backend (dabubble-backend). The API client sends every request there.
NEXT_PUBLIC_API_URL=http://localhost:8000
